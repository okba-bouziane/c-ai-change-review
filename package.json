{
  "name": "claude-review",
  "displayName": "Claude Review",
  "description": "Review, accept, and reject file changes made by Claude Code using native VS Code diffs.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "review",
    "diff",
    "claude code",
    "ai"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Claude Review restores and deletes workspace files, so it only runs in trusted workspaces."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeReview",
          "title": "Claude Review",
          "icon": "media/claude-review.svg"
        }
      ]
    },
    "views": {
      "claudeReview": [
        {
          "id": "claudeReview.changes",
          "name": "Changes",
          "icon": "media/claude-review.svg",
          "contextualTitle": "Claude Review"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeReview.changes",
        "contents": "No changes to review.\nFiles changed by Claude Code in this workspace will appear here, grouped by Added, Modified, Deleted, and Renamed.\n[Refresh](command:claudeReview.refresh)",
        "when": "workspaceFolderCount > 0"
      },
      {
        "view": "claudeReview.changes",
        "contents": "Open a folder to start reviewing changes.\n[Open Folder](command:vscode.openFolder)",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "commands": [
      {
        "command": "claudeReview.refresh",
        "title": "Refresh",
        "category": "Claude Review",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeReview.startSession",
        "title": "Start New Review Session",
        "category": "Claude Review",
        "icon": "$(debug-restart)"
      },
      {
        "command": "claudeReview.showLog",
        "title": "Show Log",
        "category": "Claude Review",
        "icon": "$(output)"
      },
      {
        "command": "claudeReview.openDiff",
        "title": "Review File\u2026",
        "category": "Claude Review",
        "icon": "$(diff)"
      },
      {
        "command": "claudeReview.reviewNext",
        "title": "Review Next Pending File",
        "category": "Claude Review",
        "icon": "$(arrow-down)"
      },
      {
        "command": "claudeReview.acceptFile",
        "title": "Accept Change",
        "category": "Claude Review",
        "icon": "$(check)"
      },
      {
        "command": "claudeReview.rejectFile",
        "title": "Reject Change",
        "category": "Claude Review",
        "icon": "$(discard)"
      },
      {
        "command": "claudeReview.openFile",
        "title": "Open File",
        "category": "Claude Review",
        "icon": "$(go-to-file)"
      },
      {
        "command": "claudeReview.filter",
        "title": "Filter by Review Status\u2026",
        "category": "Claude Review",
        "icon": "$(filter)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeReview.reviewNext",
          "when": "view == claudeReview.changes",
          "group": "navigation@1"
        },
        {
          "command": "claudeReview.filter",
          "when": "view == claudeReview.changes",
          "group": "navigation@2"
        },
        {
          "command": "claudeReview.refresh",
          "when": "view == claudeReview.changes",
          "group": "navigation@9"
        },
        {
          "command": "claudeReview.startSession",
          "when": "view == claudeReview.changes",
          "group": "z_more@0"
        },
        {
          "command": "claudeReview.showLog",
          "when": "view == claudeReview.changes",
          "group": "z_more@1"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeReview.openFile",
          "when": "view == claudeReview.changes && viewItem =~ /^file\\./",
          "group": "inline@0"
        },
        {
          "command": "claudeReview.acceptFile",
          "when": "view == claudeReview.changes && viewItem =~ /^file\\.[a-z]+\\.pending/",
          "group": "inline@1"
        },
        {
          "command": "claudeReview.rejectFile",
          "when": "view == claudeReview.changes && viewItem =~ /^file\\.[a-z]+\\.pending$/",
          "group": "inline@2"
        },
        {
          "command": "claudeReview.openDiff",
          "when": "view == claudeReview.changes && viewItem =~ /^file\\./",
          "group": "1_review@0"
        },
        {
          "command": "claudeReview.openFile",
          "when": "view == claudeReview.changes && viewItem =~ /^file\\./",
          "group": "1_review@1"
        },
        {
          "command": "claudeReview.acceptFile",
          "when": "view == claudeReview.changes && viewItem =~ /^file\\.[a-z]+\\.pending/",
          "group": "2_decide@0"
        },
        {
          "command": "claudeReview.rejectFile",
          "when": "view == claudeReview.changes && viewItem =~ /^file\\.[a-z]+\\.pending$/",
          "group": "2_decide@1"
        }
      ],
      "editor/title": [
        {
          "command": "claudeReview.acceptFile",
          "when": "claudeReview.inReviewDiff && claudeReview.activeReviewStatus == pending",
          "group": "navigation@-2"
        },
        {
          "command": "claudeReview.rejectFile",
          "when": "claudeReview.inReviewDiff && claudeReview.activeReviewStatus == pending",
          "group": "navigation@-1"
        },
        {
          "command": "claudeReview.reviewNext",
          "when": "claudeReview.inReviewDiff",
          "group": "navigation@-0"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeReview.acceptFile",
          "when": "claudeReview.inReviewDiff && claudeReview.activeReviewStatus == pending"
        },
        {
          "command": "claudeReview.rejectFile",
          "when": "claudeReview.inReviewDiff && claudeReview.activeReviewStatus == pending"
        },
        {
          "command": "claudeReview.openFile",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Claude Review",
      "properties": {
        "claudeReview.autoTrack": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Automatically start a review session when a workspace opens, so changes made afterwards (by Claude Code or anything else) are listed for review."
        },
        "claudeReview.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.DS_Store"
          ],
          "markdownDescription": "Glob patterns for paths that are never tracked. Patterns without `/` match a name at any depth."
        },
        "claudeReview.snapshot.sensitivePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".env",
            ".env.*",
            "*.pem",
            "*.key",
            "*.p12",
            "*.pfx",
            "id_rsa*",
            "id_ecdsa*",
            "id_ed25519*",
            ".npmrc",
            ".netrc",
            ".pypirc"
          ],
          "markdownDescription": "Files matching these patterns are never copied into extension storage. Changes to them are still detected, but they cannot be rejected automatically unless they are tracked in Git."
        },
        "claudeReview.snapshot.maxFileSizeMB": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "markdownDescription": "Uncommitted or untracked files larger than this are not copied when a session starts. Changes are still detected, but those files cannot be rejected automatically."
        },
        "claudeReview.snapshot.maxTotalSizeMB": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "markdownDescription": "Maximum total size copied when a session starts."
        },
        "claudeReview.filesystemMode.maxFiles": {
          "type": "number",
          "default": 20000,
          "minimum": 1,
          "markdownDescription": "Outside Git repositories every file must be copied at session start. Workspaces with more files than this are not tracked."
        },
        "claudeReview.confirmReject": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask for confirmation before rejecting a single file. Rejecting restores the file's original content (or deletes a file that did not exist); a copy of the rejected content is always kept in extension storage."
        },
        "claudeReview.openNextAfterDecision": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "After accepting or rejecting from a diff editor, close it and open the next pending file."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test:integration": "npm run build && npm run compile-tests && vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.94.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
